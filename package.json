{
    "$schema": "https://www.schemastore.org/package.json",
    "private": true,
    "type": "module",
    "scripts": {
        "build": "vite build",
        "dev": "vite",
        "check:js": "node --check public/js/app.js && node --check public/js/dcc.js && node --check public/js/engage.js && node --check public/js/login.js && node --check public/js/admin.js",
        "serve:wsl": "wsl --cd . -d Ubuntu -- php artisan serve --host=0.0.0.0 --port=8000",
        "test:wsl": "wsl --cd . -d Ubuntu -- php artisan test"
    },
    "devDependencies": {
        "@tailwindcss/vite": "^4.0.0",
        "axios": "^1.11.0",
        "concurrently": "^9.0.1",
        "laravel-vite-plugin": "^2.0.0",
        "tailwindcss": "^4.0.0",
        "vite": "^7.0.7"
    }
}
